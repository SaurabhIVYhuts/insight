# ============================================================================
# IVYHUTS Market Insight — environment variables
# ============================================================================
# Copy this file to `.env.local` for local development (`npm start` loads it
# via scripts/local-api-server.js), and set the SAME values in the Vercel
# project's Environment Variables (Production + Preview) for deploys.
#
# All of these are SERVER-SIDE ONLY. Nothing here is a REACT_APP_* var and
# nothing here is exposed to the browser.
#
# >>> This app is designed to share the SAME MongoDB + SAME Upstash Redis as
# >>> the main ivyhuts-website app. Point the two blocks below at the exact
# >>> same instances the main app uses. That gives you: full snapshot
# >>> history from day one, a working "overview" tab (reads the main app's
# >>> Lead/Enquiry/User collections), and the Amber catalog crawl keeps the
# >>> main site's search/location index warm.
# ============================================================================


# ── MongoDB (api/_lib/mongodb.js, api/_lib/models/*) ────────────────────────
# REQUIRED. Same connection string as the main app. Used for: the
# InsightSnapshot history collection, and read-only access to Lead / Enquiry
# / User for the CRM "overview" numbers.
MONGODB_URI=your_mongodb_connection_string


# ── Upstash Redis (api/_lib/sharedStore.js) ────────────────────────────────
# REQUIRED for real multi-instance behaviour (crawl state, locks, login
# sessions, rate-limit counters). Same instance as the main app.
# Either the UPSTASH_* pair or the KV_* pair works — set whichever the main
# app uses.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: per-request Redis timeout in ms (default 5000).
# REDIS_TIMEOUT_MS=5000


# ── Amber API gateway (api/_lib/amberGateway.js) ───────────────────────────
# Global Amber request budget, rolling per-minute, shared across every
# caller through Redis. Amber's hard limit is 10/min — keep a safety margin.
AMBER_MAX_REQUESTS_PER_MINUTE=6
# Optional: pages/minute reserved for the background catalog crawl so it
# never starves a live dashboard request (default: half the budget).
# AMBER_CRAWL_RESERVED_PER_MINUTE=3
# Optional: abort a hung Amber response after this many ms (default 25000).
AMBER_FETCH_TIMEOUT_MS=25000


# ── Cron auth (api/_lib/routes/insights/daily-digest.js + advance-crawl.js) ─
# REQUIRED for the daily digest cron and the crawl-keeper endpoint. Vercel
# Cron sends this automatically as a Bearer token for the scheduled
# daily-digest job. Generate your own random value (e.g. `openssl rand -hex 32`).
CRON_SECRET=your_cron_secret


# ── Daily digest email (api/_lib/mailer.js via Resend) ─────────────────────
# REQUIRED for the 08:00 IST report email to actually send. Without a key
# the snapshot is still generated and stored; only the email step fails and
# is recorded on the snapshot's `email` field (shown on the dashboard's
# Data & Cache Status card).
RESEND_API_KEY=your_resend_api_key
# Comma-separated recipient list for the daily market-intelligence report.
INSIGHTS_REPORT_RECIPIENTS=you@example.com
# Optional — defaults to "IVYhuts <onboarding@resend.dev>" (Resend sandbox
# sender, only delivers to your own Resend account email). Set to a verified
# domain sender for real delivery, e.g. "IVYhuts <insights@ivyhuts.com>".
RESEND_FROM=IVYhuts <onboarding@resend.dev>
# Optional — only used for the "View Full Dashboard" link + email footer.
SITE_URL=https://insight.ivyhuts.com/


# ── Auth / sessions (api/_lib/session.js, userStore.js, authRateLimit.js) ──
# All optional; safe defaults shown. Sessions live in the shared Redis under
# session:* keys, so accounts that already exist in the main app work here
# with no extra setup.
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SIGNUP_RATE_LIMIT=5
# Optional bcrypt cost factor for new signups (default 12).
# AUTH_BCRYPT_COST=12


# ── CORS (api/_lib/cors.js) ────────────────────────────────────────────────
# Optional. Only relevant if some other browser origin needs to call this
# app's /api/auth/* with credentials. Comma-separated exact origins, no
# trailing slash. Leave unset for a self-contained deployment.
# CRM_ORIGIN=


# ── Set automatically by Vercel — do NOT set these yourself ────────────────
# NODE_ENV       -> "production" on Vercel, unset locally
# VERCEL_ENV     -> "production" | "preview" | "development"
